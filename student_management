# Create Student Class (OOP) in the above format . 


class student():
  def __init__(self , name , age , roll , course , marks):
    self.name = name
    self.age = age
    self.roll = roll
    self.course = course
    self.marks = marks

  def display(self):
    print("name:", self.name , ", age:" , self.age , ", roll:" , self.roll , ", course:" , self.course , ", marks:" , self.marks)

